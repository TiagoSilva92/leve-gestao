@model IEnumerable<TarefaListaViewModel>
@{
    ViewData["Title"] = "Tarefas";
    var isGestor = (bool)ViewBag.IsGestor;
}

<h2 class="uk-heading">Tarefas</h2>

@if (isGestor)
{
    <div class="uk-margin-bottom">
        <a asp-action="Criar" class="uk-button uk-button-primary">Nova tarefa</a>
    </div>
}

@if (!Model.Any())
{
    <div class="uk-alert-default" uk-alert>
        <p class="uk-text-center uk-text-muted">
            <span uk-icon="info"></span>
            @if (isGestor)
            {
                @:Nenhuma tarefa criada ainda. Clique em "Nova tarefa" para começar.
            }
            else
            {
                @:Você não possui tarefas atribuídas no momento.
            }
        </p>
    </div>
}
else
{
    <div class="uk-overflow-auto">
        <table class="uk-table uk-table-striped uk-table-hover uk-table-middle">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>@(isGestor ? "Colaborador" : "Criada por")</th>
                    <th>Data limite</th>
                    <th>Status</th>
                    <th class="uk-text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@(t.Mensagem.Length > 60 ? t.Mensagem.Substring(0, 60) + "..." : t.Mensagem)</td>
                        <td>@t.NomeResponsavel</td>
                        <td>@t.DataLimite.ToString("dd/MM/yyyy")</td>
                        <td><span class="uk-badge">@t.StatusDescricao</span></td>
                        <td class="uk-text-center">
                            <a asp-action="Detalhes" asp-route-id="@t.Id"
                               class="uk-button uk-button-default uk-button-small">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
